generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  CONFIRMED
  PAID
  CANCELLED
  OVERDUE
  VOID
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  UPI
  CHEQUE
}

// ---------- Users (owner: auth) ----------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  firstName    String?
  lastName     String?
  passwordHash String
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true)
  resetToken   String?   @unique
  resetExpires DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  subscriptions       Subscription[]
  invoices            Invoice[]
  payments            Payment[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------- Catalog (owner: products/plans) ----------

model Tax {
  id          String  @id @default(cuid())
  name        String
  ratePercent Decimal @db.Decimal(5, 2)
  active      Boolean @default(true)

  products Product[]
  lines    SubscriptionLine[]
}

model Product {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("Software")
  description  String?
  salesPrice   Decimal  @default(0) @db.Decimal(12, 2)
  costPrice    Decimal  @default(0) @db.Decimal(12, 2)
  priceMonthly Decimal? @db.Decimal(12, 2)
  priceAnnual  Decimal? @db.Decimal(12, 2)
  notes        String?
  active       Boolean  @default(true)
  taxId        String?
  tax          Tax?     @relation(fields: [taxId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variants      ProductVariant[]
  subLines      SubscriptionLine[]
  templateLines QuotationTemplateLine[]
  discounts     Discount[]

  @@map("products")
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute  String
  value      String
  extraPrice Decimal @default(0) @db.Decimal(12, 2)

  subLines      SubscriptionLine[]
  templateLines QuotationTemplateLine[]

  @@unique([productId, attribute, value])
  @@map("product_variants")
}

model Plan {
  id          String        @id @default(cuid())
  name        String
  price       Decimal       @db.Decimal(12, 2)
  period      BillingPeriod
  minQuantity Int           @default(1)
  startDate   DateTime      @default(now())
  endDate     DateTime?
  autoClose   Boolean       @default(false)
  closable    Boolean       @default(true)
  pausable    Boolean       @default(false)
  renewable   Boolean       @default(true)

  subscriptions Subscription[]
  templates     QuotationTemplate[]

  @@map("plans")
}

// ---------- Quotes & subscriptions (owner: subscriptions) ----------

model QuotationTemplate {
  id           String @id @default(cuid())
  name         String
  validityDays Int    @default(30)
  planId       String
  plan         Plan   @relation(fields: [planId], references: [id])

  lines         QuotationTemplateLine[]
  subscriptions Subscription[]

  @@map("quotation_templates")
}

model QuotationTemplateLine {
  id         String            @id @default(cuid())
  templateId String
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product           @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant?   @relation(fields: [variantId], references: [id])
  quantity   Int               @default(1)

  @@map("quotation_template_lines")
}

model Subscription {
  id              String             @id @default(cuid())
  number          String             @unique
  customerId      String
  customer        User               @relation(fields: [customerId], references: [id])
  planId          String
  plan            Plan               @relation(fields: [planId], references: [id])
  templateId      String?
  template        QuotationTemplate? @relation(fields: [templateId], references: [id])
  status          SubscriptionStatus @default(DRAFT)
  paused          Boolean            @default(false)
  startDate       DateTime           @default(now())
  expiryDate      DateTime?
  paymentTerms    String?
  quoteValidUntil DateTime?
  nextBillingDate DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  lines     SubscriptionLine[]
  invoices  Invoice[]
  discounts Discount[]

  @@index([status, nextBillingDate])
  @@index([customerId])
  @@map("subscriptions")
}

model SubscriptionLine {
  id             String          @id @default(cuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  quantity       Int
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxId          String?
  tax            Tax?            @relation(fields: [taxId], references: [id])
  amount         Decimal         @db.Decimal(12, 2)

  @@map("subscription_lines")
}

// ---------- Discounts (owner: invoices/discounts) ----------

model Discount {
  id             String        @id @default(cuid())
  name           String
  type           DiscountType
  value          Decimal       @db.Decimal(12, 2)
  minPurchase    Decimal?      @db.Decimal(12, 2)
  minQuantity    Int?
  startDate      DateTime      @default(now())
  endDate        DateTime?
  usageLimit     Int?
  timesUsed      Int           @default(0)
  scope          DiscountScope
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("discounts")
}

// ---------- Invoices & payments (owner: invoices / payments) ----------

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  customerId     String
  customer       User          @relation(fields: [customerId], references: [id])
  status         InvoiceStatus @default(DRAFT)
  periodStart    DateTime      @default(now())
  periodEnd      DateTime      @default(now())
  issueDate      DateTime      @default(now())
  dueDate        DateTime      @default(now())
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  @@unique([subscriptionId, periodStart])
  @@index([status, dueDate])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  taxPercent     Decimal @default(0) @db.Decimal(5, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  amount         Decimal @db.Decimal(12, 2)

  @@map("invoice_lines")
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  paidAt       DateTime      @default(now())
  note         String?
  recordedById String
  recordedBy   User          @relation(fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
  @@map("payments")
}
