<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════════
         AUTH TOKEN — List + Form Views
         ════════════════════════════════════════════════════════════════════ -->

    <record id="view_auth_token_list" model="ir.ui.view">
        <field name="name">auth.token.list</field>
        <field name="model">auth.token</field>
        <field name="arch" type="xml">
            <list string="Tokens" decoration-danger="state == 'revoked' or state == 'blacklisted'"
                  decoration-warning="state == 'expired' or is_expired"
                  decoration-success="state == 'active' and not is_expired">
                <field name="name"/>
                <field name="token_type" widget="badge"/>
                <field name="algorithm"/>
                <field name="user_id"/>
                <field name="scopes"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'expired'"
                       decoration-danger="state in ('revoked', 'blacklisted')"/>
                <field name="expires_at"/>
                <field name="last_used_at"/>
                <field name="issued_ip"/>
                <field name="is_expired" optional="hide"/>
                <button name="action_revoke" type="object" string="Revoke"
                        icon="fa-ban" invisible="state != 'active'"/>
            </list>
        </field>
    </record>

    <record id="view_auth_token_form" model="ir.ui.view">
        <field name="name">auth.token.form</field>
        <field name="model">auth.token</field>
        <field name="arch" type="xml">
            <form string="Token">
                <header>
                    <button name="action_revoke" type="object" string="Revoke Token"
                            class="btn-danger" invisible="state != 'active'"/>
                    <button name="action_blacklist" type="object" string="Blacklist"
                            class="btn-danger" invisible="state == 'blacklisted'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,expired,revoked,blacklisted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Token Name…"/></h1>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="token_type"/>
                            <field name="algorithm"/>
                            <field name="user_id"/>
                            <field name="jti"/>
                        </group>
                        <group string="Lifecycle">
                            <field name="expires_at"/>
                            <field name="last_used_at"/>
                            <field name="revoked_at" invisible="not revoked_at"/>
                            <field name="revoked_reason" invisible="not revoked_at"/>
                        </group>
                    </group>
                    <group>
                        <group string="Scopes &amp; Provider">
                            <field name="scopes"/>
                            <field name="oauth_provider_id"/>
                        </group>
                        <group string="Client Info">
                            <field name="issued_ip"/>
                            <field name="user_agent"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Security Hash">
                            <group>
                                <field name="token_hash" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_auth_token_search" model="ir.ui.view">
        <field name="name">auth.token.search</field>
        <field name="model">auth.token</field>
        <field name="arch" type="xml">
            <search string="Search Tokens">
                <field name="name"/>
                <field name="user_id"/>
                <field name="jti"/>
                <filter string="Active" name="active" domain="[('state','=','active')]"/>
                <filter string="Expired" name="expired" domain="[('state','=','expired')]"/>
                <filter string="Revoked" name="revoked" domain="[('state','=','revoked')]"/>
                <filter string="Blacklisted" name="blacklisted" domain="[('state','=','blacklisted')]"/>
                <separator/>
                <filter string="Access Tokens" name="access" domain="[('token_type','=','access')]"/>
                <filter string="Refresh Tokens" name="refresh" domain="[('token_type','=','refresh')]"/>
                <filter string="API Keys" name="api_key" domain="[('token_type','=','api_key')]"/>
                <group expand="0" string="Group By">
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'token_type'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_auth_token" model="ir.actions.act_window">
        <field name="name">Tokens</field>
        <field name="res_model">auth.token</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_auth_token_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
