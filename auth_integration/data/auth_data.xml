<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── System Parameters ────────────────────────────────────────── -->
        <record id="param_jwt_secret" model="ir.config_parameter">
            <field name="key">auth_integration.jwt_secret</field>
            <field name="value">CHANGE_ME_IN_PRODUCTION_USE_STRONG_SECRET_256BIT</field>
        </record>

        <record id="param_jwt_ttl" model="ir.config_parameter">
            <field name="key">auth_integration.jwt_ttl_minutes</field>
            <field name="value">60</field>
        </record>

        <record id="param_refresh_ttl" model="ir.config_parameter">
            <field name="key">auth_integration.refresh_ttl_days</field>
            <field name="value">30</field>
        </record>

        <record id="param_max_sessions" model="ir.config_parameter">
            <field name="key">auth_integration.max_sessions_per_user</field>
            <field name="value">5</field>
        </record>

        <record id="param_brute_force_limit" model="ir.config_parameter">
            <field name="key">auth_integration.brute_force_limit</field>
            <field name="value">5</field>
        </record>

        <!-- ── Scheduled Actions ─────────────────────────────────────────── -->
        <record id="cron_expire_tokens" model="ir.cron">
            <field name="name">Auth: Expire Tokens</field>
            <field name="model_id" ref="model_auth_token"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_tokens()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <record id="cron_expire_sessions" model="ir.cron">
            <field name="name">Auth: Expire Sessions</field>
            <field name="model_id" ref="model_auth_session"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_sessions()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
