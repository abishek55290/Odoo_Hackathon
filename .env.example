# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/odoo_hackathon?schema=public"

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_STRING_MIN_64_CHARS_IN_PROD"
SESSION_MAX_AGE_MS=86400000

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"

# ── SMTP (leave blank to disable email; system will warn but still run) ───────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@odoo-hackathon.dev"

# ── Password Reset ────────────────────────────────────────────────────────────
RESET_TOKEN_EXPIRY_MINUTES=30
APP_BASE_URL="http://localhost:3000"

# ── Rate limiting ─────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_DURATION_SECONDS=900
