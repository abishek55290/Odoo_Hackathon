# ── Application & Server ──────────────────────────────────────────
NODE_ENV=development
PORT=3000
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-secure-random-secret-for-nextauth"
SESSION_SECRET="change-this-to-a-secure-random-secret-min-64-chars"
SESSION_MAX_AGE_MS=86400000
APP_BASE_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL="postgresql://brightloop:brightloop@localhost:5432/brightloop?schema=public"

# ── Password Reset & Auth ──────────────────────────────────────────
RESET_TOKEN_EXPIRY_MINUTES=30
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_DURATION_SECONDS=900

# ── SMTP / Mailer (Mailtrap or local sandbox) ──────────────────────
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Brightloop <noreply@brightloop.test>"
MAIL_FROM="Brightloop <noreply@brightloop.test>"
